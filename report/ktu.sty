\ProvidesPackage{ktu}

\RequirePackage{fontspec}
\RequirePackage{unicode-math}

\setmainfont{Times New Roman}
\setmathfont{XITS Math}


% #1 gets replaced with the name (e.g. "figure") and #2 gets replaced with the reference number (e.g. "12")
% http://mirrors.ctan.org/macros/latex/contrib/caption/caption.pdf
\DeclareCaptionLabelFormat{bf}{\textbf{#1~#2.}}
\captionsetup{labelformat=bf, labelsep=space}
\captionsetup[figure]{name=Fig.}

% https://www.overleaf.com/learn/latex/Questions/Which_OTF_or_TTF_fonts_are_supported_via_fontspec
\setmainfont{Times New Roman}
\setsansfont{Arial}  % Calibri
\setmonofont{Courier New}
\setmathfont{XITS Math}

% spacing 1, 1.5, or 1.15
% \singlespacing
% \onehalfspacing
\renewcommand{\baselinestretch}{1.15}

% set space after the paragraph
\setlength{\parskip}{10pt}

\addto\captionsenglish{
    \renewcommand{\contentsname}{Table of Contents}
    \renewcommand{\cfttoctitlefont}{\hfill\normalsize\bfseries}
    \renewcommand{\cftaftertoctitle}{\hfill}
}

\geometry{
    a4paper,
    left=30mm,
    right=10mm,
    top=20mm,
    bottom=20mm,
}

% hyperlinks
\usepackage{hyperref}
\hypersetup{
	colorlinks=true,
	linkcolor=black,    
	urlcolor=blue,
	citecolor=black,
	plainpages=false,
}
\urlstyle{same}

% table of content
\renewcommand{\cftsecleader}{\cftdotfill{\cftdotsep}}  % dots
\setcounter{tocdepth}{4}  % add subsubsubsection to contens

% No paragraph indent
\setlength{\parindent}{0cm}
% \setlength{\mathindent}{0cm}  % uncomment to align equations on the left, and change the \usepackage part

% new line tolerance
\sloppy
\setlength{\emergencystretch}{3em}


% Section tuning
\titleformat{\section}
{\normalfont\bfseries}  %  \scshape\large\centering
{\thesection~}{1em}{}  % \MakeUppercase
\titlespacing{\section}{\parindent}{10pt}{10pt}  % {3em}{3em}

\titleformat{\subsection}
  {\normalfont\bfseries}  % \centering
  {\thesubsection~}{1em}{}
\titlespacing{\subsection}{\parindent}{10pt}{10pt}

\titleformat{\subsubsection}
  {\normalfont\bfseries}
  {\thesubsubsection~}{1em}{}
\titlespacing{\subsubsection}{\parindent}{10pt}{10pt}

\titleformat{\subsubsubsection}
  {\normalfont}
  {\thesubsubsubsection~}{0pt}{}
\titlespacing{\subsubsubsection}{\parindent}{10pt}{10pt}

% each section starts from new line
\newcommand{\sectionbreak}{\clearpage}
\preto{\section}{\clearpage}

% page numbering
\pagestyle{fancy}  % turn on the style
\fancyhf{} % clear the header and the footer
\renewcommand{\headrulewidth}{0pt}  % remove the horizontal line
\fancyfoot[R]{\thepage}  % set the right side of the footer to be the page number
% redefine plain style
\fancypagestyle{plain}{
    \renewcommand{\headrulewidth}{0pt}
    \fancyhf{}
    \fancyfoot[R]{\thepage}
}

% no spacing between itemize and enumerate
\setlist{noitemsep}

% enumerate numbering
% \setlist[enumerate]{label={\arabic*.}}  % no nesting, i.e. 1., 2., 3.
\setlist[enumerate]{label*={\arabic*.}}  % nesting, i.e. 1.1., 1.2., 1.3.

% minted config
% https://www.overleaf.com/learn/latex/Code_Highlighting_with_minted#Reference_guide
\usemintedstyle{emacs}
\definecolor{backgroundgray}{gray}{0.95}
\setminted{fontsize=\footnotesize, baselinestretch=1}

% where images are stored
\graphicspath{ {images/} }
